# ============================================
# SOCIETYFLOW - MYSQL CONFIGURATION TEMPLATE
# ============================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Replace all [PLACEHOLDER] values with your actual values from cPanel
# 3. Save the file
# 4. Run: php artisan config:clear
#
# ============================================

APP_NAME="SocietyFlow"
APP_ENV=production
APP_KEY=base64:CSGPMHKDvId+M1Edptv/QOsc+/GbM+pplVkq1sP9cIg=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://societyflow.burgersoftwares.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ============================================
# DATABASE CONFIGURATION - MYSQL
# ============================================
# Replace [PLACEHOLDER] values with your cPanel MySQL credentials
#
# Example:
# If cPanel shows:
#   Database: cpaneluser_societyflow_db
#   User: cpaneluser_societyflow_user
#   Password: MyStrongPassword123!
#
# Then use:
#   DB_DATABASE=cpaneluser_societyflow_db
#   DB_USERNAME=cpaneluser_societyflow_user
#   DB_PASSWORD=MyStrongPassword123!
# ============================================

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=[YOUR_DATABASE_NAME_FROM_CPANEL]
DB_USERNAME=[YOUR_DATABASE_USER_FROM_CPANEL]
DB_PASSWORD=[YOUR_DATABASE_PASSWORD]

# ============================================
# SESSION CONFIGURATION
# ============================================

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# ============================================
# CACHE & QUEUE CONFIGURATION
# ============================================

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=
CACHE_DRIVER=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================
# MAIL CONFIGURATION
# ============================================

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# AWS CONFIGURATION (Optional)
# ============================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================
# VITE CONFIGURATION
# ============================================

VITE_APP_NAME="${APP_NAME}"

# ============================================
# SOCIETYFLOW SPECIFIC CONFIGURATION
# ============================================

SOCIETYFLOW_VERSION=1.0.0
SOCIETYFLOW_LICENSE_KEY=
SOCIETYFLOW_DEMO_MODE=false

# ============================================
# PAYMENT GATEWAYS (Optional)
# ============================================

RAZORPAY_KEY=
RAZORPAY_SECRET=
STRIPE_KEY=
STRIPE_SECRET=

# ============================================
# SMS CONFIGURATION (Optional)
# ============================================

SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
