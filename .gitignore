# ==========================================
# SocietyFlow Git Ignore
# ==========================================

# Laravel dependencies
/vendor/

# Environment / secrets
.env
.env.*
!.env.example
!.env.mysql.template

# Laravel runtime / uploaded files
/storage/*
/storage/app/public/*
/storage/framework/*
/storage/logs/*
/bootstrap/cache/*



# Laravel generated files
/public/hot
/public/storage

# Node
/node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==========================================
# Flutter
# ==========================================

/societyflowmob/.dart_tool/
/societyflowmob/build/
/societyflowmob/.flutter-plugins
/societyflowmob/.flutter-plugins-dependencies
/societyflowmob/.packages
# Kotlin 2.x compiler session dir, created by Gradle builds
/societyflowmob/.kotlin/
# Machine-specific SDK paths
/societyflowmob/local.properties

# Flutter generated files
/societyflowmob/android/.gradle/
/societyflowmob/android/local.properties
/societyflowmob/android/key.properties

/societyflowmob/ios/Pods/
/societyflowmob/ios/.symlinks/
/societyflowmob/ios/Flutter/ephemeral/
# macos/linux/windows ephemeral dirs are covered by the .gitignore files
# Flutter ships inside each platform folder.

# JVM crash dumps left behind when a Gradle/Kotlin build runs out of memory.
# Also matched by the *.log rule below; listed explicitly because they are
# large (a replay dump reached 2.4 MB here) and easy to commit by accident.
hs_err_pid*.log
replay_pid*.log

# Release artifacts - build these, never commit them
*.apk
*.aab

# ==========================================
# IDE
# ==========================================

.idea/
.vscode/

# ==========================================
# OS
# ==========================================

.DS_Store
Thumbs.db

# ==========================================
# Logs / temporary
# ==========================================

*.log
*.tmp
*.temp

# ==========================================
# Certificates / private keys
# ==========================================

*.pem
*.key
*.p12
*.jks
*.keystore
phpunit.result.cache

# PHPUnit
.phpunit.result.cache

# Local dev database (contains real PII - never commit)
/database/*.sqlite
/database/*.sqlite-journal
