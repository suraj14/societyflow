<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_DEBUG" value="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="CACHE_DRIVER" value="array"/>
        <!-- In-memory SQLite: no external service required, so the suite is
             runnable anywhere. Set DB_CONNECTION=mysql in CI to additionally
             verify MySQL portability (see docs/TESTING.md). -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_FOREIGN_KEYS" value="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="EXTERNAL_MESSAGING_ENABLED" value="false"/>
        <!-- The suite signs in with the code the API returns, which only a local/development/testing server that opted in does. -->
        <env name="OTP_EXPOSE_DEV_CODE" value="true"/>
        <env name="OTP_RESEND_COOLDOWN" value="0"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="FAST2SMS_API_KEY" value=""/>
        <env name="SMS_API_KEY" value=""/>
        <!-- a developer's real .env must not leak sender/template IDs into the routing tests -->
        <env name="FAST2SMS_SENDER_ID" value=""/>
        <env name="FAST2SMS_TEMPLATE_ID" value=""/>
        <env name="FAST2SMS_OTP_ID" value=""/>
        <env name="FAST2SMS_ROUTE" value=""/>
    </php>
</phpunit>
